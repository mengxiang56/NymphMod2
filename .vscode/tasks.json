{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-debug-for-hot-reload",
      "type": "process",
      "command": "${config:sts2.dotnetExe}",
      "args": [
        "build",
        "${workspaceFolder}\\Nymph.csproj",
        "-c",
        "Debug",
