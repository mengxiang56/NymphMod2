{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run STS2 Debug",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-debug-for-hot-reload",
      "program": "${config:sts2.installDir}\\${config:sts2.gameExeName}",
      "cwd": "${config:sts2.installDir}",
      "console": "internalConsole",
      "sourceFileMap": {
        ".\\": "${workspaceFolder}\\"
      },
      "stopAtEntry": false
    }
  ]
}
