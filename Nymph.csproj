<Project Sdk="Godot.NET.Sdk/4.5.1">
    <PropertyGroup>
        <GameBranch Condition="'$(GameBranch)' == ''">public-beta</GameBranch>
        <NymphRitsuLibVersion>0.5.11</NymphRitsuLibVersion>
        <GameMinVersion Condition="'$(GameBranch)' == 'public'">0.107.1</GameMinVersion>
        <GameMinVersion Condition="'$(GameBranch)' == 'public-beta'">0.111.0</GameMinVersion>
        <RitsuLibPackageId Condition="'$(GameBranch)' == 'public'">STS2.RitsuLib.Compat.0.107.1</RitsuLibPackageId>
        <RitsuLibPackageId Condition="'$(GameBranch)' == 'public-beta'">STS2.RitsuLib</RitsuLibPackageId>
        <BranchPropsFile>$(MSBuildProjectDirectory)\local.$(GameBranch).props</BranchPropsFile>
    </PropertyGroup>

    <Import Project="$(BranchPropsFile)" Condition="Exists('$(BranchPropsFile)')"/>
    <Import Project=".\local.props"
            Condition="'$(GameBranch)' == 'public-beta' and !Exists('$(BranchPropsFile)') and Exists('.\local.props')"/>

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>13.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>true</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <RootNamespace>Nymph</RootNamespace>
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
        <NoWarn>$(NoWarn);MSB3270;CS0436</NoWarn>

        <GodotExportPreset>Windows Desktop</GodotExportPreset>
        <Sts2Dir Condition="'$(Sts2Dir)' == ''">$(MSBuildProgramFiles32)\Steam\steamapps\common\Slay the Spire 2</Sts2Dir>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>
        <ModOutputDir Condition="'$(ModOutputDir)' == ''">$(Sts2Dir)\mods\NymphModSTS2\</ModOutputDir>
        <ModPckPath>$(ModOutputDir)\$(MSBuildProjectName).pck</ModPckPath>
        <Sts2Branch Condition="'$(Sts2Branch)' == '' and '$(GameBranch)' == 'public-beta'">public-beta</Sts2Branch>
        <DefineConstants Condition="'$(GameBranch)' == 'public'">$(DefineConstants);STS2_PUBLIC</DefineConstants>
        <DefineConstants Condition="'$(GameBranch)' == 'public-beta'">$(DefineConstants);STS2_PUBLIC_BETA</DefineConstants>
        <!-- 本机测试时 RitsuLib 包/构建逻辑会使用这个目录把 RitsuLib 部署到游戏 mods/STS2-RitsuLib。 -->
        <!-- Local test builds use this directory when RitsuLib package/build logic deploys RitsuLib to game mods/STS2-RitsuLib. -->
        <RitsuLibDeployDir Condition="'$(RitsuLibDeployDir)' == ''">$(Sts2Dir)\mods\STS2-RitsuLib</RitsuLibDeployDir>
        <CopyModOnBuild Condition="'$(CopyModOnBuild)' == ''">true</CopyModOnBuild>
        <RunPckExport Condition="'$(RunPckExport)' == '' and '$(DesignTimeBuild)' != 'true'">true</RunPckExport>
        <RunPckExport Condition="'$(RunPckExport)' == ''">false</RunPckExport>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <Optimize>false</Optimize>
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <Optimize>true</Optimize>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer" Version="2.2.1" PrivateAssets="all"/>
        <PackageReference Include="Nothing.STS2RitsuLib.ModAnalyzers" Version="0.8.2" PrivateAssets="all"/>
        <!-- 主线 RitsuLib（STS2 0.105.0+），跟踪 NuGet 最新版本。兼容分支和 manifest 版本对齐规则见 README。 -->
        <PackageReference Include="$(RitsuLibPackageId)" Version="$(NymphRitsuLibVersion)" GeneratePathProperty="true"/>
    </ItemGroup>

    <ItemGroup>
        <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="0Harmony" HintPath="$(Sts2DataDir)\0Harmony.dll" Private="True"/>
        <Reference Include="sts2" HintPath="$(Sts2DataDir)\sts2.dll" Private="True"/>
        <Reference Include="Steamworks.NET" HintPath="$(Sts2DataDir)\Steamworks.NET.dll" Private="True"/>
    </ItemGroup>

    <ItemGroup>
        <!-- 中文：排除 Godot、IDE 和构建输出目录，避免本地生成文件参与编译。 -->
        <!-- English: Exclude Godot, IDE, and build output directories so local generated files are not compiled. -->
        <Compile Remove=".godot/**;.idea/**;.vs/**;bin/**;obj/**;tmp/**"/>
        <EmbeddedResource Remove=".godot/**;.idea/**;.vs/**;bin/**;obj/**;tmp/**"/>
        <None Remove=".godot/**;.idea/**;.vs/**;bin/**;obj/**;tmp/**"/>

        <AdditionalFiles Include="Nymph/localization/**/*.json"/>

        <Compile Remove="Nymph/**"/>
        <EmbeddedResource Remove="Nymph/**"/>
        <None Include="Nymph/**"/>
        <None Include="Nymph.json"/>
        <None Include="project.godot"/>
        <None Include="export_presets.cfg"/>
        <None Include=".gitignore"/>
        <None Include="local.props.template"/>
        <None Include="local.public.props.template"/>
        <None Include="local.public-beta.props.template"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="local.props" Condition="Exists('local.props')"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Nymph\images\cards\"/>
        <Folder Include="Nymph\images\characters\"/>
        <Folder Include="Nymph\images\potions\"/>
        <Folder Include="Nymph\images\relics\"/>
        <Folder Include="Nymph\scenes\characters\"/>
    </ItemGroup>

    <Target Name="ValidateSts2GameInstall" BeforeTargets="ResolveAssemblyReferences">
        <Error Condition="'$(GameBranch)' != 'public' and '$(GameBranch)' != 'public-beta'"
               Text="Unsupported GameBranch '$(GameBranch)'. Use 'public' or 'public-beta'."/>
        <Error Condition="'$(Sts2Branch)' != '$(GameBranch)'"
               Text="The selected build branch is '$(GameBranch)', but the configured game SDK branch is '$(Sts2Branch)'. Create local.$(GameBranch).props from its template and point it at the matching game installation."/>
        <Error Condition="!Exists('$(Sts2DataDir)\sts2.dll')" Text="Could not find sts2.dll under '$(Sts2DataDir)'. Copy local.props.template to local.props and set Sts2Dir/Sts2DataDir for your local game install."/>
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\validate-game-sdk.ps1&quot; -ReleaseInfoPath &quot;$(Sts2Dir)\release_info.json&quot; -ExpectedVersion &quot;$(GameMinVersion)&quot; -ExpectedBranch &quot;$(GameBranch)&quot;"/>
    </Target>

    <Target Name="GenerateBranchManifest">
        <PropertyGroup>
            <GeneratedManifestFile>$(IntermediateOutputPath)$(MSBuildProjectName).json</GeneratedManifestFile>
        </PropertyGroup>
        <MakeDir Directories="$(IntermediateOutputPath)"/>
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\generate-branch-manifest.ps1&quot; -TemplatePath &quot;$(MSBuildProjectDirectory)\$(MSBuildProjectName).json&quot; -OutputPath &quot;$(GeneratedManifestFile)&quot; -MinGameVersion &quot;$(GameMinVersion)&quot; -RitsuLibVersion &quot;$(NymphRitsuLibVersion)&quot;"/>
    </Target>

    <Target Name="CopyMod" AfterTargets="Build" DependsOnTargets="GenerateBranchManifest" Condition="'$(CopyModOnBuild)' != 'false'">
        <MakeDir Directories="$(ModOutputDir)"/>
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModOutputDir)"/>
        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
              DestinationFolder="$(ModOutputDir)"
              Condition="Exists('$(TargetDir)$(TargetName).pdb')"/>
        <Copy SourceFiles="$(GeneratedManifestFile)" DestinationFiles="$(ModOutputDir)\$(MSBuildProjectName).json"/>
    </Target>

    <Target Name="CleanSpineGodotTempFiles" BeforeTargets="ExportPCK" Condition="'$(RunPckExport)' == 'true'">
        <ItemGroup>
            <SpineGodotTempFile Include="$(MSBuildProjectDirectory)\SpineGodotExtension4.5.1\windows\~libspine_godot.windows.editor.x86_64.dll*" />
        </ItemGroup>
        <Delete Files="@(SpineGodotTempFile)" />
    </Target>

    <Target Name="ExportPCK" AfterTargets="Build" Condition="'$(RunPckExport)' == 'true' and '$(STS2_SKIP_PCK_EXPORT)' != '1'">
        <Error Condition="'$(GodotExe)' == '' or !Exists('$(GodotExe)')" Text="GodotExe is required for PCK export. Copy local.props.template to local.props and set GodotExe, or build with /p:RunPckExport=false."/>
        <MakeDir Directories="$(ModOutputDir)"/>
        <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="&quot;$(GodotExe)&quot; --headless --path &quot;$(MSBuildProjectDirectory)&quot; --export-pack &quot;$(GodotExportPreset)&quot; &quot;$(ModPckPath)&quot;" EnvironmentVariables="STS2_SKIP_PCK_EXPORT=1"/>
    </Target>

</Project>
